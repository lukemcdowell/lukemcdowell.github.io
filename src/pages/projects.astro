---
import PageLayout from "../layouts/PageLayout.astro";
import { Image } from "astro:assets";
import topsifyImg from "../assets/images/topsify.png";
import musaicImg from "../assets/images/musaic.png";
import jamesFinlayImg from "../assets/images/jamesFinlayRunningCoaching.png";

const projects = [
  {
    title: "James Finlay Running Coaching",
    description:
      "Static site for a running coaching business, built with Astro and featuring a custom intro animation, scroll-driven UI, and a serverless contact form (Cloudflare Pages Functions + Turnstile + Resend).",
    href: "https://jamesfinlayrunningcoaching.co.uk/",
    image: jamesFinlayImg,
  },
  {
    title: "topSify",
    description:
      "Web app to display my top Spotify tracks, artists, & genres. Built with Next.js and the Spotify API.",
    href: "https://topsify.vercel.app/",
    source: "https://github.com/lukemcdowell/topsify",
    image: topsifyImg,
  },
  {
    title: "Musaic",
    description:
      "Web app to create a mosaic of your favourite albums. Users can add their favourite album covers to a grid, rearrange them, and export their grid as an image. Integrates with the Spotify API to get album covers.",
    href: "https://musaic-grid.vercel.app/",
    source: "https://github.com/lukemcdowell/musaic",
    image: musaicImg,
  },
  {
    title: "Minimal Chess",
    description:
      "Chrome extension to hide short-format games and distractions on Chess.com and Lichess.",
    href: "https://chromewebstore.google.com/detail/minimal-chess/jogeehcjecblahccnemfebciigamdhmd",
  },
];
---

<PageLayout title="projects">
  <section>
    <div class="flex flex-col gap-6">
      {
        projects.map(({ title, description, href, image }) => (
          <a href={href} target="_blank" class="group border border-zinc-700 rounded-lg overflow-hidden hover:border-[#247BA0] hover:no-underline! block">
            {image && (
              <Image src={image} alt={title} class="w-full object-cover" />
            )}
            <div class="p-4">
              <p class="font-bold mb-2 highlight-text group-hover:underline">{title}</p>
              <p class="text-sm leading-relaxed">{description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</PageLayout>
